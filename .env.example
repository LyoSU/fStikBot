# ── Telegram Bot ─────────────────────────────────────────────
BOT_TOKEN=
# Main bot token for cross-bot messaging (e.g. broadcasting). Falls back to BOT_TOKEN if same bot.
MAIN_BOT_TOKEN=
# Public domain for webhook mode (omit to use long-polling)
BOT_DOMAIN=
# Port the webhook HTTP server listens on (default: 2500)
WEBHOOK_PORT=2500

# ── Telegram MTProto (optional) ──────────────────────────────
# Used to look up a sticker set's owner (/about, catalog publishing).
# Leave empty to disable that lookup.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ── MongoDB ──────────────────────────────────────────────────
MONGODB_URI=mongodb://mongo:27017/fstikbot
# MONGO_POOL_SIZE=50
# MONGO_POOL_MIN=10

# ── Redis (optional: Bull queues for video convert, remove-bg, video notes) ──
# Without REDIS_HOST those features reply "unavailable"; sessions are in-memory.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Tenor (GIF search in inline packs) ───────────────────────
# Tenor v2 (tenor.googleapis.com). The key must be a Google API key with the
# Tenor API enabled — v1 keys are dead.
TENOR_KEY=
# Tenor answers 403 unless the request carries the client_key the key was issued
# for. Leave empty to use the default, 'gboard'.
TENOR_CLIENT_KEY=

# ── GramAds (optional ad integration) ────────────────────────
GRAMADS_TOKEN=

# ── Observability ────────────────────────────────────────────
# error | warn | info | debug
# LOG_LEVEL=info
# Per-stage handler timing lines in the log; 0 disables.
# PERF_TIMING=1

# ── Tunables (defaults are what production runs with) ────────
# STICKER_INFLIGHT_PER_USER=3
# COPY_PACE_MS=1000
# RETRY_MAX_WAIT_S=5
# BROADCAST_RATE_PER_SEC=25
